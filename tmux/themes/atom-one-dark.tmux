# Atom One Dark
set -g status-style 'bg=#282c34,fg=#abb2bf'
set -g status-left  '#[fg=#61afef,bold] #S '
set -g status-right '#[fg=#56b6c2] %H:%M #[fg=#abb2bf]| %d %b'
set -g window-status-format         '#[fg=#5c6370] #I:#W '
set -g window-status-current-format '#[fg=#e5c07b,bold] #I:#W '
set -g pane-border-style        'fg=#3e4451'
set -g pane-active-border-style 'fg=#61afef'
set -g message-style 'bg=#3e4451,fg=#e5c07b'
