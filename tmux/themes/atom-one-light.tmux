# Atom One Light
set -g status-style 'bg=#fafafa,fg=#383a42'
set -g status-left  '#[fg=#4078f2,bold] #S '
set -g status-right '#[fg=#0184bc] %H:%M #[fg=#383a42]| %d %b'
set -g window-status-format         '#[fg=#a0a1a7] #I:#W '
set -g window-status-current-format '#[fg=#c18401,bold] #I:#W '
set -g pane-border-style        'fg=#e5e5e6'
set -g pane-active-border-style 'fg=#4078f2'
set -g message-style 'bg=#e5e5e6,fg=#c18401'
