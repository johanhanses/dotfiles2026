#!/usr/bin/env bash
# Sync tmux theme with macOS appearance + theme-family state file.

FAMILY=$(cat "$HOME/.config/theme-family" 2>/dev/null || echo tokyonight)
if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == "Dark" ]]; then
  MODE=dark
else
  MODE=light
fi

tmux source-file "$HOME/.config/tmux/theme-$FAMILY-$MODE.conf"
