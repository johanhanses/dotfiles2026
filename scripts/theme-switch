#!/usr/bin/env sh
# theme-switch: toggle or set the active theme family across the stack.
#
# Usage:
#   theme-switch                  # toggle tokyonight <-> everforest
#   theme-switch tokyonight       # set explicitly
#   theme-switch everforest
#
# Touches: ghostty, btop, delta (via ~/themes.gitconfig), starship,
# yazi, matterhorn, sketchybar, tmux. Neovim picks up on next FocusGained.

set -e

DOTFILES="${DOTFILES:-$HOME/Repos/github.com/johanhanses/dotfiles2026}"
STATE_FILE="$HOME/.config/theme-family"

mkdir -p "$(dirname "$STATE_FILE")"
CURRENT=$(cat "$STATE_FILE" 2>/dev/null || echo tokyonight)

if [ -n "$1" ]; then
  NEW="$1"
else
  [ "$CURRENT" = tokyonight ] && NEW=everforest || NEW=tokyonight
fi

case "$NEW" in
  tokyonight|everforest) ;;
  *) echo "Unknown theme family: $NEW (expected tokyonight|everforest)" >&2; exit 1 ;;
esac

printf '%s\n' "$NEW" > "$STATE_FILE"

if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -q Dark; then
  MODE=dark
else
  MODE=light
fi

# --- 1. Ghostty: rewrite the single `theme =` line ---
case "$NEW" in
  tokyonight) GT='theme = dark:TokyoNight Night,light:TokyoNight Day' ;;
  everforest) GT='theme = dark:Everforest Dark Hard,light:Everforest Light Med' ;;
esac
sed -i '' -E "s|^theme = .*|$GT|" "$DOTFILES/ghostty/config"

# --- 2. btop: rewrite the single `color_theme =` line (restart btop to see it) ---
case "$NEW-$MODE" in
  tokyonight-*)    BT='tokyo-night' ;;
  everforest-dark)  BT='everforest-dark-hard' ;;
  everforest-light) BT='everforest-light-medium' ;;
esac
sed -i '' -E "s|^color_theme = .*|color_theme = \"$BT\"|" "$DOTFILES/btop/btop.conf"

# --- 3. Symlinks: starship + yazi + matterhorn ---
ln -sf "starship.toml.$NEW"                      "$DOTFILES/starship.toml"
ln -sf "theme-$NEW.toml"                         "$DOTFILES/yazi/theme.toml"
ln -sf "theme-$NEW-$MODE.custom.theme"           "$DOTFILES/matterhorn/theme.custom.theme"

# --- 4. delta via ~/themes.gitconfig (already `[include]`d from .gitconfig) ---
case "$NEW" in
  tokyonight) DT='tokyonight_night' ;;
  everforest) DT='ansi' ;;
esac
cat > "$HOME/themes.gitconfig" <<CFG
[delta]
    syntax-theme = $DT
CFG

# --- 5. Mattermost Desktop REST sync (if credentials exist) ---
if [ -x "$DOTFILES/scripts/mattermost-theme-sync" ]; then
  "$DOTFILES/scripts/mattermost-theme-sync" 2>/dev/null || true
fi

# --- 6. Live reloads ---
sketchybar --reload >/dev/null 2>&1 || true
# Ghostty reloads via its keybind, not AppleScript. Users can hit
# Cmd+Shift+, or we can send the command via `osascript` as a fallback.
osascript -e 'tell application "System Events" to keystroke "," using {command down, shift down}' >/dev/null 2>&1 || true

# tmux: re-source across all sessions
if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  "$HOME/.config/tmux/scripts/tmux-theme-sync" >/dev/null 2>&1 || true
fi

echo "Theme family: $NEW ($MODE)"
