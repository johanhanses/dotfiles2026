"$schema" = 'https://starship.rs/config-schema.json'

format = """
[░▒▓](#A7C080)\
[  ](bg:#A7C080 fg:#1E2326)\
[](bg:#7FBBB3 fg:#A7C080)\
$directory\
[](fg:#7FBBB3 bg:#374145)\
$git_branch\
$git_status\
[](fg:#374145 bg:#272E33)\
$nodejs\
$rust\
$golang\
$php\
[](fg:#272E33 bg:#1E2326)\
$time\
[ ](fg:#1E2326)\
\n$character"""

[directory]
style = "fg:#1E2326 bg:#7FBBB3"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = " "
"Pictures" = " "

[git_branch]
symbol = ""
style = "bg:#374145"
format = '[[ $symbol $branch ](fg:#7FBBB3 bg:#374145)]($style)'

[git_status]
style = "bg:#374145"
format = '[[($all_status$ahead_behind )](fg:#7FBBB3 bg:#374145)]($style)'

[nodejs]
symbol = ""
style = "bg:#272E33"
format = '[[ $symbol ($version) ](fg:#7FBBB3 bg:#272E33)]($style)'

[rust]
symbol = ""
style = "bg:#272E33"
format = '[[ $symbol ($version) ](fg:#7FBBB3 bg:#272E33)]($style)'

[golang]
symbol = ""
style = "bg:#272E33"
format = '[[ $symbol ($version) ](fg:#7FBBB3 bg:#272E33)]($style)'

[php]
symbol = ""
style = "bg:#272E33"
format = '[[ $symbol ($version) ](fg:#7FBBB3 bg:#272E33)]($style)'

[time]
disabled = false
time_format = "%R" # Hour:Minute Format
style = "bg:#1E2326"
format = '[[  $time ](fg:#9DA9A0 bg:#1E2326)]($style)'
