# Maximum items to keep per feed
max-items 500

# macOS
browser "open -g -a 'Google Chrome' %u"

# Linux/Ubuntu
# browser "xdg-open %u"

# WSL - Open Windows Microsoft Edge
# browser "explorer.exe %u"

# Basic display settings
show-read-feeds yes
feed-sort-order unreadarticlecount-asc

# Colors — Atom One (via terminal ANSI palette; auto-follows Ghostty light/dark)
color background       default default
color listnormal       default default
color listnormal_unread default default bold
color listfocus        default blue    bold
color listfocus_unread default cyan    bold
color info             default blue    bold
color article          default default
color title            blue    default bold
color hint-key         yellow  default bold
color hint-description default default

# Key bindings
bind-key j down
bind-key k up
bind-key J next-feed
bind-key K prev-feed
bind-key G end
bind-key g home
bind-key l open
bind-key h quit
